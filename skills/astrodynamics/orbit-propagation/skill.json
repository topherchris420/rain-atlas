{
  "schema": "atlas.skill/v1",
  "name": "orbit-propagation",
  "version": "1.0.0",
  "kind": "executable",
  "domain": "astrodynamics",
  "summary": "Propagate an Earth orbit under configurable gravity and report conservation diagnostics.",
  "capabilities": [
    "astro.orbit-propagation",
    "astro.numerical-integration"
  ],
  "entrypoint": "run.py",
  "determinism": "deterministic",
  "inputs": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "config": {
        "type": "object"
      },
      "elements": {
        "type": "object"
      },
      "compare_analytic": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "outputs": {
    "type": "object",
    "required": [
      "final_state_km_kms",
      "relative_two_body_energy_drift"
    ],
    "properties": {
      "final_state_km_kms": {
        "type": "array"
      },
      "relative_two_body_energy_drift": {
        "type": "number"
      },
      "analytic_max_position_error_m": {
        "type": "number"
      }
    }
  },
  "permissions": {
    "network": false,
    "subprocess": false,
    "read": [
      "inputs"
    ],
    "write": [
      "outputs"
    ]
  },
  "limits": {
    "timeout_s": 120,
    "memory_mb": 2048
  },
  "requires": {
    "python": ">=3.11",
    "packages": {
      "numpy": ">=2.0",
      "scipy": ">=1.13",
      "rain-atlas": ">=0.1"
    }
  },
  "examples": [
    {
      "name": "leo-two-body-vs-analytic",
      "tolerance": {
        "abs": 0.01
      }
    }
  ],
  "references": [
    "Vallado, D. A. (2013). Fundamentals of Astrodynamics and Applications, 4th ed. Microcosm Press.",
    "Montenbruck, O. & Gill, E. (2000). Satellite Orbits. Springer."
  ],
  "limitations": [
    "Earth-centred only",
    "no drag/SRP/tides/relativity"
  ]
}
