{
  "schema": "atlas.skill/v1",
  "name": "kepler-reference",
  "version": "1.0.0",
  "kind": "executable",
  "domain": "astrodynamics",
  "summary": "Closed-form two-body propagation and the classical elements of the result.",
  "capabilities": [
    "astro.two-body",
    "astro.analytic-reference"
  ],
  "entrypoint": "run.py",
  "determinism": "deterministic",
  "inputs": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "state_km_kms": {
        "type": "array"
      },
      "elements": {
        "type": "object"
      },
      "dt_s": {
        "type": "number"
      },
      "mu_km3_s2": {
        "type": "number"
      }
    },
    "required": [
      "dt_s"
    ]
  },
  "outputs": {
    "type": "object",
    "required": [
      "final_state_km_kms",
      "sma_km",
      "eccentricity"
    ],
    "properties": {
      "final_state_km_kms": {
        "type": "array"
      },
      "sma_km": {
        "type": "number"
      },
      "eccentricity": {
        "type": "number"
      },
      "inclination_deg": {
        "type": "number"
      }
    }
  },
  "permissions": {
    "network": false,
    "subprocess": false,
    "read": [
      "inputs"
    ],
    "write": [
      "outputs"
    ]
  },
  "limits": {
    "timeout_s": 60,
    "memory_mb": 2048
  },
  "requires": {
    "python": ">=3.11",
    "packages": {
      "numpy": ">=2.0",
      "scipy": ">=1.13",
      "rain-atlas": ">=0.1"
    }
  },
  "examples": [
    {
      "name": "circular-quarter-period",
      "tolerance": {
        "abs": 1e-05
      }
    }
  ],
  "references": [
    "Vallado, D. A. (2013). Fundamentals of Astrodynamics and Applications, 4th ed. Microcosm Press.",
    "Montenbruck, O. & Gill, E. (2000). Satellite Orbits. Springer."
  ],
  "limitations": [
    "Elliptic orbits",
    "point-mass gravity"
  ]
}
