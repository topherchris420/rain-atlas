{
  "schema": "atlas.skill/v1",
  "name": "synchronization-sweep",
  "version": "1.0.0",
  "kind": "executable",
  "domain": "resonance",
  "summary": "Two-oscillator synchronization simulation sweep.",
  "capabilities": [
    "resonance.synchronization-sweep"
  ],
  "entrypoint": "run.py",
  "determinism": "seeded",
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "couplings": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "diffusions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "phase_lags": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "dt": {
        "type": "number",
        "minimum": 0.001,
        "maximum": 0.1
      },
      "duration_s": {
        "type": "number",
        "minimum": 1,
        "maximum": 200
      },
      "replicates": {
        "type": "integer",
        "minimum": 3,
        "maximum": 40
      }
    },
    "required": [
      "couplings",
      "diffusions",
      "phase_lags",
      "dt",
      "duration_s",
      "replicates"
    ]
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "phases": {
        "type": "object",
        "required": [
          "$artifact",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "$artifact": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "conditions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coupling": {
              "type": "number"
            },
            "diffusion": {
              "type": "number"
            },
            "phase_lag": {
              "type": "number"
            }
          },
          "required": [
            "coupling",
            "diffusion",
            "phase_lag"
          ]
        }
      },
      "dt": {
        "type": "number"
      },
      "duration_s": {
        "type": "number"
      },
      "replicates": {
        "type": "integer"
      },
      "omega_rad_s": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 1,
        "maxItems": 32768
      },
      "unit": {
        "type": "string"
      },
      "integrator": {
        "type": "string"
      }
    },
    "required": [
      "phases",
      "conditions",
      "dt",
      "duration_s",
      "replicates",
      "omega_rad_s",
      "unit",
      "integrator"
    ]
  },
  "permissions": {
    "network": false,
    "subprocess": false,
    "read": [
      "inputs"
    ],
    "write": [
      "outputs"
    ]
  },
  "limits": {
    "timeout_s": 180,
    "memory_mb": 1024
  },
  "requires": {
    "python": ">=3.11",
    "packages": {
      "numpy": ">=2.0",
      "scipy": ">=1.13",
      "rain-atlas": ">=0.1"
    }
  },
  "examples": [
    {
      "name": "analytical",
      "seed": 17,
      "tolerance": {
        "abs": 1e-10
      }
    }
  ],
  "limitations": [
    "Two phase oscillators, synthetic data only; finite-window locking, not a thermodynamic phase transition.",
    "Approximate Student-t intervals over independent simulations; no calibrated probability of physical truth.",
    "PLV and time-domain frequency analysis share raw data; replication uses new seeded trajectories."
  ],
  "references": [
    "docs/RESONANCE.md"
  ]
}
